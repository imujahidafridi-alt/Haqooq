rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function userExists() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    
    function isAdmin() {
      return isAuthenticated() && userExists() && getUserData().role == 'admin';
    }
    function isVerifiedLawyer() {
      return isAuthenticated() && userExists() && getUserData().role == 'lawyer' && getUserData().status == 'verified';
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin() || (resource != null && resource.data.role == 'lawyer' && resource.data.status == 'verified');
      allow create: if isOwner(userId) && request.resource.data.role != 'admin' && 
                       (!request.resource.data.keys().hasAny(['isPremium', 'biddingCredits']) || request.resource.data.isPremium == false) &&
                       (!request.resource.data.keys().hasAny(['credits']) || request.resource.data.credits <= 10);
      allow update: if isOwner(userId) && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['isPremium', 'biddingCredits', 'status', 'role', 'credits'])) || isAdmin();
    }

    match /cases/{caseId} {
      allow read, write: if isAuthenticated() && resource != null && resource.data.clientId == request.auth.uid;
      allow read: if isVerifiedLawyer() && resource != null && (resource.data.status == 'open' || resource.data.assignedLawyerId == request.auth.uid);
      allow update: if isVerifiedLawyer() && resource != null && resource.data.assignedLawyerId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.clientId == request.auth.uid;
    }

    match /proposals/{proposalId} {
        allow write: if isVerifiedLawyer() && request.resource.data.lawyerId == request.auth.uid || 
                     (isAuthenticated() && get(/databases/$(database)/documents/cases/$(request.resource.data.caseId)).data.clientId == request.auth.uid);
        
        allow read: if (isAuthenticated() && get(/databases/$(database)/documents/cases/$(resource.data.caseId)).data.clientId == request.auth.uid) || 
                       (isVerifiedLawyer() && resource != null && resource.data.lawyerId == request.auth.uid);
    }

    match /chats/{chatId} {
      allow read, update: if isAuthenticated() && (resource.data.participants.hasAny([request.auth.uid]) || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.participants.hasAny([request.auth.uid]);
      
      match /messages/{messageId} {
        allow read, write: if isAuthenticated() && (get(/databases/$(database)/documents/chats/$(chatId)).data.participants.hasAny([request.auth.uid]) || isAdmin());
      }
    }

    match /notifications/{notificationId} {
      allow create: if isAuthenticated();
      allow read, update, delete: if false; 
    }

    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false; 
    }

    match /transactions/{txId} {
      allow read: if resource != null && (isOwner(resource.data.userId) || isAdmin());
      allow create: if isAuthenticated() && 
                       request.resource.data.userId == request.auth.uid && 
                       request.resource.data.status == 'completed' && 
                       request.resource.data.type in ['premium_profile', 'bidding_credits', 'bid_submission'];
      allow write: if false; 
    }

    match /credit_purchases/{purchaseId} {
      allow create: if isAuthenticated() && request.resource.data.lawyerId == request.auth.uid;
      allow read: if isAuthenticated() && resource.data.lawyerId == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
